# Local Python environments and generated caches/builds.
.venv/
.venv-*/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.py[cod]
*.egg-info/
build/
dist/
.DS_Store

# Credentials and local business inputs must stay outside version control.
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key
/inputs/
/uploads/
/reports/
/local-data/
/private-data/
/sample-result.json

# Dependency wheels and delivery archives are local distribution artifacts.
/deliveries/
*.whl
*.zip
*.tar.gz

# New outputs are private/local by default. These exceptions preserve only
# the existing fictional acceptance evidence and its reproducible video inputs.
# Review data content before adding any new exception; never force-add inputs.
/outputs/**
